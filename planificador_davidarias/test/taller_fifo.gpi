set terminal pngcairo size 1024,440 font "sans,10"
set output 'test/taller_fifo.png'
set title "Diagrama de Gantt"
set xlabel "Tiempo"
set ylabel "Proceso"
set xrange [0:17]
set yrange [0:5]
set xtics 1
set grid xtics
unset key
set ytics ("P1" 4, "P2" 3, "P3" 2, "P4" 1)
set object 1 rect from 0,3.7 to 2,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 2 rect from 2,3.7 to 4,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 3 rect from 4,3.7 to 6,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 4 rect from 6,3.7 to 7,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 5 rect from 2,2.92 to 4,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 6 rect from 4,2.92 to 6,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 7 rect from 6,2.92 to 7,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 8 rect from 7,2.7 to 9,3.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 9 rect from 9,2.7 to 11,3.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 10 rect from 4,1.92 to 6,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 11 rect from 6,1.92 to 7,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 12 rect from 7,1.92 to 9,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 13 rect from 9,1.92 to 11,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 14 rect from 11,1.7 to 12,2.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 15 rect from 5,0.92 to 6,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 16 rect from 6,0.92 to 7,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 17 rect from 7,0.92 to 9,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 18 rect from 9,0.92 to 11,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 19 rect from 11,0.92 to 12,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 20 rect from 12,0.7 to 14,1.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 21 rect from 14,0.7 to 16,1.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
plot -1 notitle
