set terminal pngcairo size 1024,560 font "sans,10"
set output 'test/caso_propio_unacola_srt.png'
set title "Diagrama de Gantt"
set xlabel "Tiempo"
set ylabel "Proceso"
set xrange [0:22]
set yrange [0:7]
set xtics 1
set grid xtics
unset key
set ytics ("S1" 6, "S2" 5, "R1" 4, "R2" 3, "F1" 2, "F2" 1)
set object 1 rect from 0,5.92 to 1,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 2 rect from 1,5.92 to 2,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 3 rect from 2,5.92 to 4,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 4 rect from 4,5.92 to 6,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 5 rect from 6,5.92 to 10,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 6 rect from 10,5.92 to 15,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 7 rect from 15,5.7 to 21,6.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 8 rect from 2,4.92 to 4,5.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 9 rect from 4,4.7 to 6,5.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 10 rect from 0,3.92 to 1,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 11 rect from 1,3.92 to 2,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 12 rect from 2,3.92 to 4,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 13 rect from 4,3.92 to 6,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 14 rect from 6,3.92 to 10,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 15 rect from 10,3.7 to 15,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 16 rect from 1,2.92 to 2,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 17 rect from 2,2.92 to 4,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 18 rect from 4,2.92 to 6,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 19 rect from 6,2.7 to 10,3.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 20 rect from 0,1.7 to 1,2.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 21 rect from 1,1.92 to 2,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 22 rect from 2,1.7 to 4,2.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 23 rect from 1,0.7 to 2,1.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
plot -1 notitle
