set object 10 rect from 7,3.92 to 10,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 11 rect from 10,3.92 to 14,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
