set object 31 rect from 7,0.92 to 10,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 32 rect from 10,0.92 to 14,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 33 rect from 14,0.92 to 17,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
