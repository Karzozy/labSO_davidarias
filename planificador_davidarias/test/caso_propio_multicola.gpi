set object 13 rect from 17,3.92 to 18,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 14 rect from 18,3.7 to 20,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 15 rect from 1,2.92 to 2,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 16 rect from 2,2.92 to 4,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 17 rect from 4,2.92 to 7,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 18 rect from 7,2.92 to 10,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 19 rect from 10,2.92 to 14,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 20 rect from 14,2.7 to 17,3.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 21 rect from 17,2.92 to 18,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 22 rect from 18,2.92 to 20,3.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 23 rect from 20,2.7 to 21,3.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 24 rect from 0,1.92 to 2,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 25 rect from 2,1.92 to 4,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 26 rect from 4,1.92 to 7,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 27 rect from 7,1.7 to 10,2.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
