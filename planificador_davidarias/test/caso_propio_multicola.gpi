set terminal pngcairo size 1024,560 font "sans,10"
set output 'test/caso_propio_multicola.png'
set title "Diagrama de Gantt"
set xlabel "Tiempo"
set ylabel "Proceso"
set xrange [0:22]
set yrange [0:7]
set xtics 1
set grid xtics
unset key
set ytics ("S1" 6, "S2" 5, "R1" 4, "R2" 3, "F1" 2, "F2" 1)
set object 1 rect from 0,5.7 to 2,6.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 2 rect from 2,5.92 to 4,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 3 rect from 4,5.92 to 7,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 4 rect from 7,5.92 to 10,6.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 5 rect from 10,5.7 to 14,6.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 6 rect from 2,4.7 to 4,5.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 7 rect from 0,3.92 to 2,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 8 rect from 2,3.92 to 4,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
